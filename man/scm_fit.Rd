\itemize{
\item \code{method}: estimator name
\item \code{estimate}: average treatment effect (ATT)
\item \code{times}: time index vector
\item \code{T_pre}: number of pre-treatment periods
\item \code{Y_treat}: treated unit outcome series
\item \code{gap}: treatment effect series (Y_treat - counterfactual)
}

